# Ignoriere Mac-Systemdateien
.DS_Store

# Ignoriere versteckte JetBrains IDE-Ordner
.idea/

# Ignoriere Python-Cache
__pycache__/
*.pyc

# Ignoriere Umgebungsvariablen (API-Schlüssel)
.env
.env-*.tmp
.claude

# Ignoriere den Build der App in bin/
bin/.build/
bin/.dist/
bin/.venv/
bin/languages
bin/Languages.app/

# Ignoriere Datensicherungen
backups/

# Only vocabulary Markdown belongs in version control.
/vocabulary/*
!/vocabulary/english/
!/vocabulary/french/
!/vocabulary/german/
/vocabulary/english/*
!/vocabulary/english/*.md
/vocabulary/french/*
!/vocabulary/french/*.md
/vocabulary/german/*
!/vocabulary/german/*.md
bin/vocabulary/
bin/factory/
